MONGO_ROOT_USER=elourbano_admin
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB_NAME=elourbano

# Token exigido nos endpoints de gestão (PUT/DELETE). Gere com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Google Gemini (opcional; sem chave a priorização usa só as regras locais)
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origem permitida no CORS (endereço do front-end)
CORS_ORIGIN=http://localhost:3000
API_PORT=5000
